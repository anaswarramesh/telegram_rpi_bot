[Unit]
Description=Telegram Bot for Raspberry Pi
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/telegram_rpi_bot
ExecStart=/usr/bin/python3 /home/pi/telegram_rpi_bot/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
